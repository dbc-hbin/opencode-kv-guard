{
  "name": "opencode-kv-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stream-lifetime admission control and deterministic tool schemas for OpenCode 1.19.4",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --target bun --outfile dist/opencode-kv-guard.js && cp src/tui.tsx dist/opencode-kv-guard-tui.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:compaction": "bun run scripts/compaction-smoke.ts",
    "smoke:manual-compaction": "bun run scripts/manual-compaction-smoke.ts",
    "smoke:recovery": "bun run scripts/recovery-smoke.ts"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.41",
    "@opencode-ai/plugin": "1.19.4",
    "@opencode-ai/sdk": "1.19.4",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.4.3",
    "@types/json-schema": "7.0.15",
    "@types/node": "26.6.5",
    "ai": "6.0.168",
    "opencode-ai": "1.19.4",
    "solid-js": "1.9.10",
    "typescript": "5.9.3",
    "zod": "4.1.8"
  }
}
